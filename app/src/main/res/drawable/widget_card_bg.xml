<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta "papel crema" del widget. Se usa como background (ImageProvider) para tener
     esquinas redondeadas también en API 29/30, donde el modificador cornerRadius de
     Glance no aplica. El color se resuelve por tema (values / values-night). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card_bg" />
    <corners android:radius="20dp" />
</shape>
