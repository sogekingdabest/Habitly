rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Devuelve true si el usuario autenticado es miembro de la casa indicada.
    function isMemberOf(householdId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    function validInviteCode(code) {
      return code is string
        && code.size() >= 6
        && code.size() <= 8
        && code.matches('^[A-HJ-NP-Z2-9]+$');
    }

    function validInviteExpiry(expiresAt) {
      return expiresAt is int
        && expiresAt > request.time.toMillis()
        && expiresAt <= request.time.toMillis() + 691200000;
    }

    function validMemberProfile(profile) {
      return profile is map
        && profile.keys().hasOnly(['displayName', 'nickname'])
        && profile.displayName is string
        && profile.displayName.size() <= 100
        && profile.nickname is string
        && profile.nickname.size() <= 50;
    }

    // ─────────────────────────────────────────────────────────────
    // Perfiles de usuario
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Un perfil solo lo lee y lo escribe su dueño.
      //
      // Esto es lo que corta la cadena que permitía entrar en casas ajenas: antes
      // cualquier autenticado podía leer /users/{cualquiera}, sacar su
      // activeHouseholdId y usarlo para auto-unirse a esa casa (ver isSelfJoin más
      // abajo). Cerrada la lectura, el único modo de conocer un householdId es ser ya
      // miembro o resolver un código de invitación válido.
      //
      // Los nombres de los compañeros de casa ya no se leen de aquí: viven duplicados
      // en households/{id}.memberProfiles.
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      // Rutinas personales del usuario (y su subcolección completions)
      match /routines/{routineId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
        match /{sub=**} {
          allow read, write: if isSignedIn() && request.auth.uid == userId;
        }
      }

      // Notas personales del usuario.
      //
      // Hace falta declararla: las reglas de Firestore NO se heredan, así que el
      // `allow` del documento /users/{userId} de arriba no alcanza a sus
      // subcolecciones. Sin esta regla, las notas personales fallan con
      // PERMISSION_DENIED aunque el usuario sea su dueño.
      //
      // Se declara estrecha —solo `notes`— en vez de un comodín /{sub=**} sobre
      // /users, para no conceder de golpe acceso a subcolecciones que todavía no
      // existen. Las notas de casa viven en households/{id}/notes y las cubre el
      // comodín de esa rama.
      match /notes/{noteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ─────────────────────────────────────────────────────────────
    // Lookup de códigos de invitación -> householdId
    // Permite resolver un código concreto (get) SIN exponer la colección
    // households a queries abiertas. La seguridad está en que el código es
    // aleatorio y solo se puede leer de uno en uno (list está prohibido).
    // ─────────────────────────────────────────────────────────────
    match /invite_codes/{code} {
      // Un código caducado deja de resolverse: sin esto era una llave permanente, y
      // quien saliera de la casa podría volver a entrar meses después con el código
      // que memorizó.
      //
      // La rama `resource == null` NO es opcional: al crear una casa (y al rotar el
      // código, que es lo que pasa al salirse o al expulsar) el cliente comprueba con un
      // get que el código candidato esté libre, y ese documento TODAVÍA NO EXISTE. En un
      // documento inexistente `resource` es null, `resource.data` revienta y la regla
      // deniega, así que sin esta rama nadie puede crear una casa ni regenerar su código:
      // PERMISSION_DENIED en el onboarding, verificado en dispositivo.
      //
      // Lo que se llega a distinguir desde fuera es "no existe" (no encontrado) de
      // "existe pero caducó" (denegado); ni uno ni otro devuelven el householdId, y el
      // cliente traduce los dos al mismo error, así que la puerta sigue cerrada.
      allow get: if isSignedIn()
        && (resource == null
            || resource.data.get('expiresAt', 0) > request.time.toMillis());
      allow list: if false;

      // El mapping solo puede nacer en el mismo batch que deja ese código como el oficial de la
      // casa. getAfter cubre tanto la creación de una casa como una rotación atómica.
      allow create: if validInviteMapping();

      // Un mapping no se borra suelto: el mismo batch debe rotar el código de la casa o borrarla.
      allow delete: if validInviteDeletion();
      allow update: if false;

      function validInviteMapping() {
        let data = request.resource.data;
        let householdPath = /databases/$(database)/documents/households/$(data.householdId);
        let householdAfter = getAfter(householdPath).data;
        return isSignedIn()
          && data.keys().hasOnly(['householdId', 'createdAt', 'expiresAt'])
          && data.householdId is string
          && data.createdAt is int
          && data.createdAt >= request.time.toMillis() - 300000
          && data.createdAt <= request.time.toMillis() + 300000
          && validInviteCode(code)
          && validInviteExpiry(data.expiresAt)
          && code == householdAfter.inviteCode
          && data.expiresAt == householdAfter.inviteCodeExpiresAt
          && ((exists(householdPath)
                && request.auth.uid in get(householdPath).data.members)
              || request.auth.uid in householdAfter.members);
      }

      function validInviteDeletion() {
        let householdPath = /databases/$(database)/documents/households/$(resource.data.householdId);
        return isSignedIn()
          && exists(householdPath)
          && request.auth.uid in get(householdPath).data.members
          && (!existsAfter(householdPath)
              || getAfter(householdPath).data.inviteCode != code);
      }
    }

    // ─────────────────────────────────────────────────────────────
    // Casas (households)
    // ─────────────────────────────────────────────────────────────
    match /households/{householdId} {

      // Solo los miembros pueden leer la casa (incluye inviteCode y members).
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;

      allow create: if validHouseholdCreation();

      // Borrar la casa (con su historial de compra y sus rutinas) es cosa solo del
      // propietario. Antes bastaba con ser miembro: cualquiera podía borrarle a los
      // demás años de datos.
      allow update: if isContentUpdate()
        || isOwnProfileUpdate()
        || isOwnerBackfill()
        || isInviteRotation()
        || isMembershipDeparture()
        || isSelfJoin();
      allow delete: if isHouseholdDeletion();

      function isMemberSelf() {
        return isSignedIn() && request.auth.uid in resource.data.members;
      }

      /**
       * Propietario efectivo. Las casas creadas antes de que existiera ownerId lo tienen
       * vacío; ahí manda el primer miembro, que por construcción es quien la creó.
       */
      function ownerOrFallback() {
        return resource.data.get('ownerId', '') != ''
          ? resource.data.ownerId
          : resource.data.members[0];
      }

      function isOwner() {
        return isSignedIn() && request.auth.uid == ownerOrFallback();
      }

      function isHouseholdDeletion() {
        let mappingPath = /databases/$(database)/documents/invite_codes/$(resource.data.inviteCode);
        return isOwner()
          && (!validInviteCode(resource.data.inviteCode) || !existsAfter(mappingPath));
      }

      function validHouseholdCreation() {
        let data = request.resource.data;
        return isSignedIn()
          && data.keys().hasOnly([
            'id', 'name', 'inviteCode', 'inviteCodeExpiresAt', 'ownerId', 'members',
            'customStores', 'memberProfiles', 'joinProofs'
          ])
          && data.id == householdId
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 100
          && validInviteCode(data.inviteCode)
          && validInviteExpiry(data.inviteCodeExpiresAt)
          && data.ownerId == request.auth.uid
          && data.members == [request.auth.uid]
          && data.customStores is list
          && data.customStores.size() <= 50
          && data.joinProofs == {}
          && data.memberProfiles.keys().hasOnly([request.auth.uid])
          && validMemberProfile(data.memberProfiles[request.auth.uid]);
      }

      /**
       * Relleno de ownerId en casas antiguas: solo si está vacío y solo si lo reclama el
       * primer miembro. Sin esta condición, cualquier miembro de una casa antigua podría
       * autoproclamarse propietario.
       */
      function isOwnerBackfill() {
        return isMemberSelf()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId'])
          && resource.data.get('ownerId', '') == ''
          && request.resource.data.ownerId == request.auth.uid
          && request.auth.uid == resource.data.members[0];
      }

      function isContentUpdate() {
        return isMemberSelf()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'customStores'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.customStores is list
          && request.resource.data.customStores.size() <= 50;
      }

      function isOwnProfileUpdate() {
        let beforeProfiles = resource.data.get('memberProfiles', {});
        let afterProfiles = request.resource.data.get('memberProfiles', {});
        return isMemberSelf()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberProfiles'])
          && afterProfiles.diff(beforeProfiles).affectedKeys().hasOnly([request.auth.uid])
          && validMemberProfile(afterProfiles[request.auth.uid]);
      }

      function validRotatedInvite() {
        let after = request.resource.data;
        let mappingPath = /databases/$(database)/documents/invite_codes/$(after.inviteCode);
        return validInviteCode(after.inviteCode)
          && validInviteExpiry(after.inviteCodeExpiresAt)
          && after.inviteCode != resource.data.inviteCode
          && existsAfter(mappingPath)
          && getAfter(mappingPath).data.householdId == householdId
          && getAfter(mappingPath).data.expiresAt == after.inviteCodeExpiresAt;
      }

      function isInviteRotation() {
        return isMemberSelf()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['inviteCode', 'inviteCodeExpiresAt'])
          && validRotatedInvite();
      }

      function isMembershipDeparture() {
        let before = resource.data;
        let after = request.resource.data;
        let removed = before.members.toSet().difference(after.members.toSet());
        let afterProfiles = after.get('memberProfiles', {});
        let beforeProfiles = before.get('memberProfiles', {});
        let afterProofs = after.get('joinProofs', {});
        let beforeProofs = before.get('joinProofs', {});
        let requesterLeaves = removed.hasOnly([request.auth.uid]);
        let ownerRemoves = isOwner() && request.auth.uid in after.members;
        let ownerBefore = before.get('ownerId', '') != ''
          ? before.ownerId
          : before.members[0];
        let expectedOwner = requesterLeaves
          && request.auth.uid == ownerBefore
          && after.members.size() > 0
          ? after.members[0]
          : ownerBefore;
        return isMemberSelf()
          && before.members.toSet().hasAll(after.members.toSet())
          && removed.size() == 1
          && after.members.size() == before.members.size() - 1
          && after.members.size() > 0
          && (requesterLeaves || ownerRemoves)
          && afterProfiles.diff(beforeProfiles).affectedKeys().hasOnly(removed)
          && afterProofs.diff(beforeProofs).affectedKeys().hasOnly(removed)
          && afterProfiles.keys().toSet().hasOnly(after.members.toSet())
          && afterProofs.keys().toSet().hasOnly(after.members.toSet())
          && after.get('ownerId', '') == expectedOwner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'members', 'memberProfiles', 'joinProofs', 'ownerId',
            'inviteCode', 'inviteCodeExpiresAt'
          ])
          && validRotatedInvite();
      }

      // Un no-miembro solo puede añadirse a sí mismo y debe escribir una prueba explícita. A
      // diferencia de comparar inviteCode sobre request.resource (que sería tautológico), el nuevo
      // joinProof no existía antes: el cliente tiene que conocer realmente el código vigente.
      function isSelfJoin() {
        let before = resource.data;
        let after = request.resource.data;
        let beforeProfiles = before.get('memberProfiles', {});
        let afterProfiles = after.get('memberProfiles', {});
        let beforeProofs = before.get('joinProofs', {});
        let afterProofs = after.get('joinProofs', {});
        return isSignedIn()
          && !(request.auth.uid in before.members)
          && after.diff(before).affectedKeys()
               .hasOnly(['members', 'memberProfiles', 'joinProofs'])
          && after.members == before.members.concat([request.auth.uid])
          && afterProfiles.diff(beforeProfiles).affectedKeys().hasOnly([request.auth.uid])
          && validMemberProfile(afterProfiles[request.auth.uid])
          && afterProofs.diff(beforeProofs).affectedKeys().hasOnly([request.auth.uid])
          && afterProofs[request.auth.uid] == before.inviteCode
          && validInviteCode(before.inviteCode)
          && before.inviteCodeExpiresAt > request.time.toMillis();
      }

      // Documentos de subcolecciones (shopping_items, shopping_history, routines de casa, …):
      // solo accesibles por miembros de la casa. En rules v2 un comodín recursivo puede coincidir
      // con cero segmentos, por eso exigimos primero collection/document; usar solo /{doc=**}
      // también alcanzaría al documento household y anularía todas las reglas de update de arriba.
      match /{collection}/{document}/{nested=**} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }

    // ─────────────────────────────────────────────────────────────
    // Reportes de respuestas del asistente IA (política de contenido
    // generado por IA de Google Play): solo crear, y solo en nombre
    // propio. La lectura queda para la consola del desarrollador.
    // ─────────────────────────────────────────────────────────────
    match /ai_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 8000
        && request.resource.data.modelId is string
        && request.resource.data.modelId.size() <= 100
        && request.resource.data.keys().hasOnly(['userId', 'modelId', 'content', 'createdAt']);
      allow read, update, delete: if false;
    }
  }
}
