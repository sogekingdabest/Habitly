rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Devuelve true si el usuario autenticado es miembro de la casa indicada.
    function isMemberOf(householdId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    // ─────────────────────────────────────────────────────────────
    // Perfiles de usuario
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // NOTA: la lectura de perfiles ajenos sigue abierta a cualquier usuario
      // autenticado porque getMemberProfiles los resuelve punto a punto y no hay
      // forma barata de validar "compartimos casa" aquí. Endurecer en una fase
      // posterior (p. ej. duplicando el nickname dentro del documento de la casa).
      allow read: if isSignedIn();
      // Solo el propio usuario puede crear/modificar/borrar su perfil.
      allow write: if isSignedIn() && request.auth.uid == userId;

      // Rutinas personales del usuario (y su subcolección completions)
      match /routines/{routineId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
        match /{sub=**} {
          allow read, write: if isSignedIn() && request.auth.uid == userId;
        }
      }
    }

    // ─────────────────────────────────────────────────────────────
    // Lookup de códigos de invitación -> householdId
    // Permite resolver un código concreto (get) SIN exponer la colección
    // households a queries abiertas. La seguridad está en que el código es
    // aleatorio y solo se puede leer de uno en uno (list está prohibido).
    // ─────────────────────────────────────────────────────────────
    match /invite_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      // Solo un miembro de la casa referenciada puede crear su mapping.
      allow create: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members;
      // Al regenerar el código, un miembro puede borrar el mapping antiguo.
      allow delete: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members;
      allow update: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // Casas (households)
    // ─────────────────────────────────────────────────────────────
    match /households/{householdId} {

      // Solo los miembros pueden leer la casa (incluye inviteCode y members).
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;

      // Al crear, el creador debe figurar como miembro.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.members;

      // Un miembro puede modificar o borrar la casa.
      // Un NO miembro solo puede añadirse a sí mismo a 'members' (unirse),
      // sin tocar ningún otro campo.
      allow update: if isMemberSelf() || isSelfJoin();
      allow delete: if isMemberSelf();

      function isMemberSelf() {
        return isSignedIn() && request.auth.uid in resource.data.members;
      }

      function isSelfJoin() {
        return isSignedIn()
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members;
      }

      // Subcolecciones (shopping_items, shopping_history, routines de casa, …):
      // solo accesibles por miembros de la casa.
      match /{document=**} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }

    // ─────────────────────────────────────────────────────────────
    // Reportes de respuestas del asistente IA (política de contenido
    // generado por IA de Google Play): solo crear, y solo en nombre
    // propio. La lectura queda para la consola del desarrollador.
    // ─────────────────────────────────────────────────────────────
    match /ai_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 8000
        && request.resource.data.modelId is string
        && request.resource.data.modelId.size() <= 100
        && request.resource.data.keys().hasOnly(['userId', 'modelId', 'content', 'createdAt']);
      allow read, update, delete: if false;
    }
  }
}
